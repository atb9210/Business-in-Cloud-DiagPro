APP_NAME="BusinessCloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=diagpro
DB_USERNAME=diagpro
DB_PASSWORD=diagpro_secure_2024

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_HOST=redis
REDIS_PASSWORD=diagpro_redis_2024
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@businesscloud.it"
MAIL_FROM_NAME="${APP_NAME}"

# Docker
CONTAINER_ROLE=app
DB_SEED=true

# Admin user (created by seeder)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@businesscloud.it
ADMIN_PASSWORD=changeme123!

# Filament
FILAMENT_PATH=admin
